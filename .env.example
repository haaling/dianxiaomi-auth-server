# 服务器配置
PORT=3000
NODE_ENV=development

# MongoDB 配置
# 本地开发
MONGODB_URI=mongodb://localhost:27017/dianxiaomi_auth
# 生产环境（mongodb.net）推荐在连接字符串中指定连接池参数：
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dianxiaomi_auth?maxPoolSize=50&minPoolSize=10

# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# 设备限制配置
MAX_DEVICES_PER_USER=3

# CORS 配置（允许的Chrome插件来源）
ALLOWED_ORIGINS=chrome-extension://your-extension-id

# 通义万相（DashScope）配置
DASHSCOPE_API_KEY=sk-d8ff2bfc846743569cbbda85e49bfc5d
WANX_DEFAULT_MODEL=wanx2.1-imageedit
